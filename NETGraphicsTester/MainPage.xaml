<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:esriUI="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui"
             x:Class="NETGraphicsTester.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#0F0F0F}">

    <Grid RowDefinitions="2*,1*"
          RowSpacing="12"
          Padding="12">
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#D7D7D7, Dark=#3A3A3A}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#101010}"
                MinimumHeightRequest="320">
            <Grid>
                <esriUI:LocalSceneView x:Name="sceneView" Scene="{Binding Scene}" />
                <Border HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="10"
                        Padding="10,4"
                        StrokeThickness="0"
                        BackgroundColor="#AA000000">
                    <Label x:Name="GraphicsCountLabel"
                           Text="Graphics: 0"
                           TextColor="White"
                           FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1"
                    Orientation="Vertical">
            <VerticalStackLayout Spacing="8">
                <Button Text="JS 1: Model LOD Preview" Clicked="ExecuteWorkflow_ModelLODs" />
                <Button Text="JS 2: Data Extraction" Clicked="ExecuteWorkflow_DataExtraction" />
                <Button Text="JS 3: Editing / Export" Clicked="ExecuteWorkflow_EditingExport" />
                <Button Text="JS 4: Selection Highlight" Clicked="ExecuteWorkflow_SelectionHighlight" />
                <Button Text="JS 5: SatelliteOrbit" Clicked="ExecuteWorkflow_SatelliteOrbit" />
                <Button Text="JS 6: MoveFormation" Clicked="ExecuteWorkflow_MoveFormation" />
                <Button Text="JS 7: RealTimeAircraft" Clicked="ExecuteWorkflow_RealTimeAircraft" />
                <Button Text="JS 8: MetroMarkers" Clicked="ExecuteWorkflow_MetroMarkers" />
                <Button Text=".NET 1: Missile Trajectory" Clicked="ExecuteWorkflow_MissileTrajectory" />
                <Button Text=".NET 2: Web Renderer" Clicked="ExecuteWorkflow_WebRenderer" />
                <Button Text=".NET 3: Create Track" Clicked="ExecuteWorkflow_CreateTrack" />
                <Button Text=".NET 4: Flashing Updates" Clicked="ExecuteWorkflow_FlashingUpdates"/>
                <Button Text="Flutter 2: Geocode Points" Clicked="ExecuteWorkflow_GeocodePoints" />
                <Button Text="Flutter 3: Transfer Overlay" Clicked="ExecuteWorkflow_TransferOverlay" />
                <Button Text="Flutter 4: Query by Extent" Clicked="ExecuteWorkflow_QueryByExtent" />
                <Button Text="Flutter 5: Filter Graphics" Clicked="ExecuteWorkflow_FilterGraphics" />
                <Button Text="Qt 1: Multifaceted Renderer" Clicked="ExecuteWorkflow_MultifacetedRenderer" />
                <Button Text="Qt 2: GeoJSON Graphics" Clicked="ExecuteWorkflow_GeoJSONGraphics" />
                <Button Text="Qt 3: Traverse Route" Clicked="ExecuteWorkflow_TraverseRoute" />
                <Button Text="Qt 4: Complex Popup" Clicked="ExecuteWorkflow_ComplexPopup" />
                <Button Text="Qt 5: Text Labels" Clicked="ExecuteWorkflow_TextLabels" />
                <Button Text="Qt 6: Follow Graphic" Clicked="ExecuteWorkflow_FollowGraphic" />
                <Button Text="Swift 1: Nearby Points" Clicked="ExecuteWorkflow_ShowNearbyPoints" />
                <Button Text="Swift 2: Drone Track" Clicked="ExecuteWorkflow_DroneTrack" />
                <Button Text="AI 1: Moving Orbit" Clicked="ExecuteWorkflow_MovingOrbit" />
                <Button Text="AI 2: Stacked Graphics" Clicked="ExecuteWorkflow_StackedGraphics" />
                <Button Text="AI 3: Offscreen Graphics" Clicked="ExecuteWorkflow_OffscreenGraphics" />
                <Button Text="AI 4: Cross Boundary" Clicked="ExecuteWorkflow_CrossBoundary" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
